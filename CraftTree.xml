<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

	<Frame name="CraftTreeFrame" toplevel="true" parent="UIParent" movable="true" enableMouse="true" hidden="true" frameStrata="DIALOG">
		<Size>
			<AbsDimension x="600" y="560"/>
		</Size>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<BackgroundInsets>
				<AbsInset left="11" right="12" top="12" bottom="11"/>
			</BackgroundInsets>
			<TileSize>
				<AbsValue val="32"/>
			</TileSize>
			<EdgeSize>
				<AbsValue val="32"/>
			</EdgeSize>
		</Backdrop>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentHeader" file="Interface\DialogFrame\UI-DialogBox-Header">
					<Size>
						<AbsDimension x="360" y="64"/>
					</Size>
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="12"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentTitle" inherits="GameFontNormal" text="CraftTree">
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-2"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentHint" inherits="GameFontDisableSmall" text="Window open: Shift-click bag/chat items  ·  Alt+Shift = normal link/split">
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-36"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentItemLabel" inherits="GameFontNormalSmall" text="Item">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="24" y="-58"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentQtyLabel" inherits="GameFontNormalSmall" text="Qty">
					<Anchors>
						<Anchor point="TOPRIGHT">
							<Offset>
								<AbsDimension x="-110" y="-58"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentShopTitle" inherits="GameFontNormal" text="Base materials">
					<Anchors>
						<Anchor point="BOTTOMLEFT">
							<Offset>
								<AbsDimension x="24" y="128"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentShopSummary" inherits="GameFontDisableSmall" text="">
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentShopTitle" relativePoint="RIGHT">
							<Offset>
								<AbsDimension x="8" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentClose" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT">
						<Offset>
							<AbsDimension x="-4" y="-4"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>

			<Frame name="$parentInputBox">
				<Size>
					<AbsDimension x="380" y="28"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="24" y="-74"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
					<EdgeSize>
						<AbsValue val="12"/>
					</EdgeSize>
					<TileSize>
						<AbsValue val="12"/>
					</TileSize>
					<BackgroundInsets>
						<AbsInset left="3" right="3" top="3" bottom="3"/>
					</BackgroundInsets>
				</Backdrop>
				<Frames>
					<EditBox name="CraftTreeFrameInput" letters="512" autoFocus="false" historyLines="8">
						<Size>
							<AbsDimension x="368" y="18"/>
						</Size>
						<Anchors>
							<Anchor point="LEFT">
								<Offset>
									<AbsDimension x="6" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<FontString inherits="ChatFontNormal"/>
						<Scripts>
							<OnEnterPressed>
								CraftTree_OnInputEnter()
							</OnEnterPressed>
							<OnEscapePressed>
								this:ClearFocus()
							</OnEscapePressed>
							<OnEditFocusGained>
								this:HighlightText()
							</OnEditFocusGained>
						</Scripts>
					</EditBox>
				</Frames>
				<Scripts>
					<OnLoad>
						this:SetBackdropColor(0, 0, 0, 0.9)
						this:SetBackdropBorderColor(0.6, 0.6, 0.6, 1)
					</OnLoad>
				</Scripts>
			</Frame>

			<Frame name="$parentQtyBox">
				<Size>
					<AbsDimension x="48" y="28"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentInputBox" relativePoint="RIGHT">
						<Offset>
							<AbsDimension x="8" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
					<EdgeSize>
						<AbsValue val="12"/>
					</EdgeSize>
					<TileSize>
						<AbsValue val="12"/>
					</TileSize>
					<BackgroundInsets>
						<AbsInset left="3" right="3" top="3" bottom="3"/>
					</BackgroundInsets>
				</Backdrop>
				<Frames>
					<EditBox name="CraftTreeFrameQty" letters="5" autoFocus="false">
						<Size>
							<AbsDimension x="36" y="18"/>
						</Size>
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<FontString inherits="ChatFontNormal"/>
						<Scripts>
							<OnEscapePressed>
								this:ClearFocus()
							</OnEscapePressed>
							<OnEnterPressed>
								CraftTree_OnInputEnter()
							</OnEnterPressed>
						</Scripts>
					</EditBox>
				</Frames>
				<Scripts>
					<OnLoad>
						this:SetBackdropColor(0, 0, 0, 0.9)
						this:SetBackdropBorderColor(0.6, 0.6, 0.6, 1)
					</OnLoad>
				</Scripts>
			</Frame>

			<Button name="$parentGo" inherits="UIPanelButtonTemplate" text="Expand">
				<Size>
					<AbsDimension x="72" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentQtyBox" relativePoint="RIGHT">
						<Offset>
							<AbsDimension x="8" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						CraftTree_OnInputEnter()
					</OnClick>
				</Scripts>
			</Button>

			<!-- Goal item header -->
			<Frame name="CraftTreeGoal">
				<Size>
					<AbsDimension x="540" y="52"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="24" y="-108"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
					<EdgeSize>
						<AbsValue val="12"/>
					</EdgeSize>
					<TileSize>
						<AbsValue val="12"/>
					</TileSize>
					<BackgroundInsets>
						<AbsInset left="3" right="3" top="3" bottom="3"/>
					</BackgroundInsets>
				</Backdrop>
				<Scripts>
					<OnLoad>
						this:SetBackdropColor(0.08, 0.08, 0.1, 0.95)
						this:SetBackdropBorderColor(0.7, 0.65, 0.3, 1)
						if CraftTree_InitGoal then CraftTree_InitGoal(this) end
					</OnLoad>
				</Scripts>
			</Frame>

			<!-- Material tree -->
			<ScrollFrame name="CraftTreeTreeScroll" inherits="UIPanelScrollFrameTemplate">
				<Size>
					<AbsDimension x="540" y="250"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="CraftTreeGoal" relativePoint="BOTTOMLEFT">
						<Offset>
							<AbsDimension x="0" y="-6"/>
						</Offset>
					</Anchor>
				</Anchors>
				<ScrollChild>
					<Frame name="CraftTreeTreeChild">
						<Size>
							<AbsDimension x="510" y="250"/>
						</Size>
					</Frame>
				</ScrollChild>
			</ScrollFrame>

			<!-- Base mats shopping strip -->
			<ScrollFrame name="CraftTreeShopScroll" inherits="UIPanelScrollFrameTemplate">
				<Size>
					<AbsDimension x="540" y="100"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMLEFT">
						<Offset>
							<AbsDimension x="20" y="20"/>
						</Offset>
					</Anchor>
				</Anchors>
				<ScrollChild>
					<Frame name="CraftTreeShopChild">
						<Size>
							<AbsDimension x="510" y="100"/>
						</Size>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
		</Frames>
		<Scripts>
			<OnLoad>
				this:RegisterForDrag("LeftButton")
				tinsert(UISpecialFrames, "CraftTreeFrame")
				CraftTreeFrameQty:SetText("1")
				if CraftTree_InitUI then CraftTree_InitUI() end
			</OnLoad>
			<OnShow>
				if CraftTree_OnShow then CraftTree_OnShow() end
			</OnShow>
			<OnDragStart>
				this:StartMoving()
			</OnDragStart>
			<OnDragStop>
				this:StopMovingOrSizing()
			</OnDragStop>
			<OnMouseDown>
				if CraftTreeFrameInput then CraftTreeFrameInput:ClearFocus() end
			</OnMouseDown>
		</Scripts>
	</Frame>
</Ui>
